{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "lrpineda.rebel-menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "lrpineda.media-card"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "io.github.fabean.herdr"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "lrpineda.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Denver",
              "zone": "America/Denver"
            },
            {
              "name": "Sao Paulo",
              "zone": "America/Sao_Paulo"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "eduardodallecort.weather-radar",
          "alertsEnabled": true
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "tray": []
    }
  },
  "plugins": []
}
